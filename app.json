{
  "expo": {
    "name": "Fixora",
    "slug": "fixora",
    "scheme": "fixora",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-updates",
      "./plugins/withAndroidArm64"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixora.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F5"
      },
      "package": "com.fixora.app",
      "versionCode": 1
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27ca9745-5c45-42f1-83a3-1530bb8c7eba"
      }
    },
    "owner": "desmonegrace85",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/27ca9745-5c45-42f1-83a3-1530bb8c7eba",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    }
  }
}
